<?xml version="1.0"?>
<package format="3">
  <name>cyx_robot_planning</name>
  <version>0.1.0</version>
  <description>Programmatic MoveIt planning, execution, state and keyboard jog servers.</description>
  <maintainer email="2159612024@qq.com">cyx_arm maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>cyx_robot_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_ros_planning</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>ros2launch</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
