<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="cyx_control_joint" params="name lower upper initial_position:=0.0">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_position}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="cyx_ros2_control" params="use_gazebo controllers_file">
    <ros2_control name="CYXArmSystem" type="system">
      <hardware>
        <xacro:if value="${use_gazebo}">
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_gazebo}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">false</param>
        </xacro:unless>
      </hardware>

      <xacro:cyx_control_joint name="arm_joint1" lower="-${pi}" upper="${pi}"/>
      <xacro:cyx_control_joint name="arm_joint2" lower="-${pi / 2}" upper="${pi / 2}"/>
      <xacro:cyx_control_joint name="arm_joint3" lower="-${4 * pi / 5}" upper="${4 * pi / 5}"/>
      <xacro:cyx_control_joint name="arm_joint4" lower="-${pi}" upper="${pi}"/>
      <xacro:cyx_control_joint name="arm_joint5" lower="-${pi / 2}" upper="${pi / 2}"/>
      <xacro:cyx_control_joint name="arm_joint6" lower="-${pi}" upper="${pi}"/>
    </ros2_control>

    <xacro:if value="${use_gazebo}">
      <gazebo reference="base_link">
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
      </gazebo>
      <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
          <parameters>${controllers_file}</parameters>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
